{
  "name": "js-vaporetto",
  "version": "0.1.0",
  "description": "Unofficial WebAssembly bindings for the Vaporetto Japanese tokenizer",
  "keywords": [
    "japanese",
    "tokenizer",
    "morphological-analysis",
    "word-segmentation",
    "nlp",
    "vaporetto",
    "wasm",
    "webassembly",
    "deno",
    "bun"
  ],
  "homepage": "https://github.com/kechol/js-vaporetto#readme",
  "bugs": {
    "url": "https://github.com/kechol/js-vaporetto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kechol/js-vaporetto.git"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Kazuyuki SUZUKI <kechol@users.noreply.github.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "workerd": "./dist/workers/vaporetto.js",
      "deno": "./dist/deno/vaporetto.js",
      "bun": "./dist/node/vaporetto.js",
      "browser": "./dist/bundler/vaporetto.js",
      "node": "./dist/node/vaporetto.js",
      "default": "./dist/bundler/vaporetto.js"
    },
    "./web": {
      "types": "./dist/web/vaporetto.d.ts",
      "default": "./dist/web/vaporetto.js"
    },
    "./workers": {
      "types": "./dist/workers/vaporetto.d.ts",
      "default": "./dist/workers/vaporetto.js"
    },
    "./node": {
      "types": "./dist/node/vaporetto.d.ts",
      "default": "./dist/node/vaporetto.js"
    },
    "./deno": {
      "types": "./dist/deno/vaporetto.d.ts",
      "default": "./dist/deno/vaporetto.js"
    },
    "./bundler": {
      "types": "./dist/bundler/vaporetto.d.ts",
      "default": "./dist/bundler/vaporetto.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/node/vaporetto.js",
  "module": "./dist/bundler/vaporetto.js",
  "browser": "./dist/bundler/vaporetto.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "README.md",
    "README.ja.md"
  ],
  "sideEffects": [
    "./dist/bundler/js_vaporetto.js",
    "./dist/bundler/vaporetto.js",
    "./dist/web/js_vaporetto.js",
    "./dist/web/vaporetto.js",
    "./dist/workers/vaporetto.js",
    "./dist/deno/js_vaporetto.js",
    "./dist/deno/vaporetto.js"
  ],
  "scripts": {
    "setup": "./scripts/setup-toolchain.sh",
    "build": "./scripts/build.sh",
    "test": "npm run test:rust && npm run test:exports && npm run test:node && npm run test:deno && npm run test:bun && npm run test:workers && npm run test:browser",
    "test:rust": "wasm-pack test --node",
    "test:exports": "node --test tests/exports.test.mjs",
    "test:node": "node --test tests/node.test.mjs",
    "test:deno": "deno test --allow-read tests/deno.test.ts",
    "test:bun": "bun test tests/bun.test.ts",
    "test:workers": "node tests/workers/run.mjs",
    "test:browser": "node tests/browser/run.mjs chromium firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings && cargo fmt --check && ./scripts/check-docs.sh",
    "check:docs": "./scripts/check-docs.sh",
    "prepublishOnly": "echo \"js-vaporetto is distributed from GitHub, not npm. Remove this guard deliberately if that changes.\" >&2 && exit 1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=20"
  }
}
